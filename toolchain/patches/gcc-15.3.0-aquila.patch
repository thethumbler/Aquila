diff -ruN a/gcc/config/aquila.h b/gcc/config/aquila.h
--- a/gcc/config/aquila.h
+++ b/gcc/config/aquila.h
@@ -0,0 +1,42 @@
+/* Target definitions for AquilaOS.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.  */
+
+/* Same type sizes as the i386 SysV ABI used by the kernel (x86-64's are
+   the LP64 ones of i386/x86-64.h).  */
+#ifndef TARGET_64BIT_DEFAULT
+#undef  SIZE_TYPE
+#define SIZE_TYPE "unsigned int"
+
+#undef  PTRDIFF_TYPE
+#define PTRDIFF_TYPE "int"
+#endif
+
+/* Only static linking is supported.  */
+#undef  LINK_SPEC
+#define LINK_SPEC "%{!shared:-static}"
+
+#undef  LIB_SPEC
+#define LIB_SPEC "-lc"
+
+/* crti/crtn come from the C library, crtbegin/crtend from libgcc.  */
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s crti.o%s crtbegin.o%s"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do {						\
+    builtin_define ("__aquila__");		\
+    builtin_define ("__unix__");		\
+    builtin_assert ("system=aquila");		\
+    builtin_assert ("system=unix");		\
+    builtin_assert ("system=posix");		\
+  } while (0)
