diff -ruN a/newlib/libc/include/sys/signal.h b/newlib/libc/include/sys/signal.h
--- a/newlib/libc/include/sys/signal.h
+++ b/newlib/libc/include/sys/signal.h
@@ -70,6 +70,9 @@
   int          si_signo;    /* Signal number */
   int          si_code;     /* Cause of the signal */
   union sigval si_value;    /* Signal value */
+#ifdef __aquila__
+  void        *si_addr;     /* Faulting address (SIGSEGV, SIGBUS, ...) */
+#endif
 } siginfo_t;
 #endif /* defined(_POSIX_REALTIME_SIGNALS) || __POSIX_VISIBLE >= 199309 */
 
@@ -113,6 +116,31 @@
 #define sa_sigaction  _signal_handlers._sigaction
 #endif
 
+#elif defined(__aquila__)
+
+#define SA_NOCLDSTOP 0x1   /* Do not generate SIGCHLD when children stop */
+#define SA_SIGINFO   0x2   /* The handler is sa_sigaction (aquila passes */
+                           /*   the siginfo to every handler) */
+#define SA_NOCLDWAIT 0x4   /* Children don't stay zombies */
+#define SA_RESTART   0x8   /* A call the signal interrupts is restarted */
+#define SA_NODEFER   0x10  /* Not blocked while its handler runs */
+#define SA_RESETHAND 0x20  /* The handler goes (SIG_DFL) once it's run */
+
+typedef void (*_sig_func_ptr)(int);
+
+/* the layout of the kernel's struct aquila_sigaction */
+struct sigaction {
+  union {
+    _sig_func_ptr _handler;  /* SIG_DFL, SIG_IGN, or pointer to a function */
+    void      (*_sigaction)( int, siginfo_t *, void * );
+  } _signal_handlers;
+  sigset_t    sa_mask;
+  int         sa_flags;
+};
+
+#define sa_handler    _signal_handlers._handler
+#define sa_sigaction  _signal_handlers._sigaction
+
 #else /* defined(__rtems__) */
 
 #define SA_NOCLDSTOP 1  /* only value supported now for sa_flags */
