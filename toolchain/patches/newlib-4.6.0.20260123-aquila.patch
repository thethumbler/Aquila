diff -ruN a/newlib/configure.host b/newlib/configure.host
--- a/newlib/configure.host
+++ b/newlib/configure.host
@@ -592,6 +592,20 @@
   z8k-*-coff)
 	sys_dir=z8ksim
 	;;
+  i[34567]86-*-aquila*)
+	sys_dir=aquila
+	posix_dir=posix
+	unix_dir=unix
+	# syscalls are provided without the leading underscore
+	newlib_cflags="${newlib_cflags} -DMISSING_SYSCALL_NAMES"
+	# provided by libc/sys/aquila
+	newlib_cflags="${newlib_cflags} -DSIGNAL_PROVIDED -DHAVE_OPENDIR -D_NO_GETCWD -DHAVE_RENAME -DHAVE_NANOSLEEP"
+	newlib_cflags="${newlib_cflags} -DHAVE_FCNTL -D_NO_GETLOGIN -D_NO_GETUT -D_NO_GETPASS -D_NO_TTYNAME"
+	# no scheduling API (sched_setparam, ...)
+	newlib_cflags="${newlib_cflags} -D_NO_POSIX_SPAWN"
+	# malloc only has sbrk
+	newlib_cflags="${newlib_cflags} -DHAVE_MMAP=0 -DHAVE_MREMAP=0"
+	;;
 esac
 
