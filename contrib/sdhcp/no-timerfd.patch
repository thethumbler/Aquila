+/* timer n expires in ts->it_value (disarmed if 0) */
 static void
 settimeout(int n, const struct itimerspec *ts)
 {
-	if (timerfd_settime(timers[n], 0, ts, NULL) < 0)
-		eprintf("timerfd_settime:");
+	struct timespec now;
+
+	if (!ts->it_value.tv_sec && !ts->it_value.tv_nsec) {
+		timers[n].tv_sec = timers[n].tv_nsec = 0;
+		return;
+	}
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	timers[n].tv_sec = now.tv_sec + ts->it_value.tv_sec;
+	timers[n].tv_nsec = now.tv_nsec + ts->it_value.tv_nsec;
+	if (timers[n].tv_nsec >= 1000000000) {
+		timers[n].tv_sec++;
+		timers[n].tv_nsec -= 1000000000;
+	}
