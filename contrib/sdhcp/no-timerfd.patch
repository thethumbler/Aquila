+/* the time left until ts (0 if it has passed) */
+static struct timespec
+timeleft(const struct timespec *ts)
+{
+	struct timespec now, left = { 0 };
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (ts->tv_sec > now.tv_sec || (ts->tv_sec == now.tv_sec && ts->tv_nsec > now.tv_nsec)) {
+		left.tv_sec = ts->tv_sec - now.tv_sec;
+		left.tv_nsec = ts->tv_nsec - now.tv_nsec;
+		if (left.tv_nsec < 0) {
+			left.tv_sec--;
+			left.tv_nsec += 1000000000;
+		}
+	}
+	return left;
+}
+
+static int
+armed(int n)
+{
+	return timers[n].tv_sec || timers[n].tv_nsec;
+}
