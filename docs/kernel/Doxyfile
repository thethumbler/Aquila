# The AquilaOS kernel's documents and code reference (make docs): only
# what differs from Doxygen's defaults. Run from docs/kernel/, the
# output's directory in $DOXYGEN_OUTPUT.

PROJECT_NAME           = "AquilaOS kernel"
PROJECT_BRIEF          = "How it works, and its code"
OUTPUT_DIRECTORY       = $(DOXYGEN_OUTPUT)
HTML_OUTPUT            = api

# the documents (README.md the main page), in reading order, and the
# kernel's sources (not arch/arm and arch/none, which aren't built)
INPUT                  = README.md architecture.md booting.md interrupts.md \
                         memory.md processes.md smp.md syscalls.md \
                         signals.md vfs.md filesystems.md devices.md \
                         networking.md building.md ../../kernel
FILE_PATTERNS          = *.md *.c *.h
RECURSIVE              = YES
EXCLUDE                = doxygen ../../kernel/arch/arm ../../kernel/arch/none ../../kernel/README.md
EXCLUDE_PATTERNS       = */tags
USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../..

# the comments quote names `like this', Markdown wants `like this`
# the documents' links to the sources, which are outside the site
FILTER_PATTERNS        = *.c=doxygen/quotes.sh *.h=doxygen/quotes.sh *.md=doxygen/mdlinks.sh

# C; a comment's first sentence is its summary (the comments are prose,
# without tags); everything listed, documented or not, static functions too
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# the kernel's headers, as the default build (x86_64) sees them
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = ../../kernel/include ../../kernel/arch/i386/include ../../include/uapi
PREDEFINED             = ARCH_BITS=64 \
                         "MALLOC_DEFINE(type, name, desc)=" \
                         "MALLOC_DECLARE(type)=" \
                         "MODULE_INIT(name, init, fini)=" \
                         "LOGGER_DEFINE(module, name, level)=" \
                         "__packed=" \
                         "__aligned(x)=" \
                         "__unused=" \
                         "__attribute__(x)="

# HTML only, with doxygen-awesome-css's theme (doxygen/, MIT), in
# aquilaos.com's colors and fonts (aquila.css; the fonts are the SIL Open
# Font License's, doxygen/fonts/)
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = doxygen/doxygen-awesome.css \
                         doxygen/doxygen-awesome-sidebar-only.css \
                         doxygen/aquila.css
HTML_EXTRA_FILES       = doxygen/fonts/ibm-plex-sans.woff2 \
                         doxygen/fonts/ibm-plex-sans-italic.woff2 \
                         doxygen/fonts/martian-mono.woff2
HAVE_DOT               = NO

# what's undocumented isn't a warning (yet): most of it is
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = $(DOXYGEN_OUTPUT)/warnings.log
