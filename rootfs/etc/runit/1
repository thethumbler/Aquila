#!/bin/sh
# runit stage 1: one time system tasks

PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/libexec:/usr/local/bin:/usr/local/sbin
export PATH

# Static devices, devfs is on /dev with /dev/console already (everyone
# may use /dev/tty, /dev/ptmx, /dev/null and /dev/zero, the rest is root's)
echo populating static devices in /dev
mknod -m 666 /dev/tty c 5 0
mknod -m 666 /dev/ptmx c 5 2
mknod -m 666 /dev/null c 1 3
mknod -m 666 /dev/zero c 1 5
mknod -m 600 /dev/fb0 c 29 0
mknod -m 600 /dev/hda b 3 0
mknod -m 600 /dev/hda1 b 3 1
mknod -m 600 /dev/ttyS0 c 4 64
for n in 1 2 3 4 5 6; do
    mknod -m 600 /dev/tty$n c 4 $n
    mknod -m 600 /dev/vcs$n c 7 $n
    mknod -m 600 /dev/vcsa$n c 7 $((128 + n))
done
mknod -m 600 /dev/mouse c 10 1
mknod -m 644 /dev/kmsg c 1 11
mknod -m 600 /dev/fd0 b 2 0

# Mount devpts on /dev/pts
echo mounting devpts on /dev/pts
mkdir /dev/pts
mount -t devpts /dev/pts

# Mount procfs on /proc
echo mounting procfs on /proc
mount -t procfs /proc

# /run has runit's state and the services' supervise directories, /tmp
# is cleared at boot
echo mounting tmpfs on /run /tmp
mount -t tmpfs /run
mount -t tmpfs /tmp
chmod 755 /run
mkdir /run/runit

# The ramdisk is read-only, its home directories are tmpfs too; on a disk
# they are kept
if ! touch /.writable 2>/dev/null; then
    echo mounting tmpfs on /root /home/live
    mount -t tmpfs /root
    mount -t tmpfs /home/live
else
    rm /.writable
fi
